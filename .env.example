# Copia este fichero a `.env` (en la raíz del proyecto) y rellena tu clave.
# El .env real está ignorado por git: tu clave nunca se sube al repositorio.

# Clave de la API de MiniMax (necesaria para la clasificación de materiales con IA).
MINIMAX_API_KEY=tu_clave_aqui

# Clave de la API de Google Gemini (necesaria para el escaneo de formularios de ensayo).
# Obtenla gratis en: https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_clave_aqui

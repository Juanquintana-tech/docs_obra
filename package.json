{
  "name": "cye-electron",
  "productName": "CYE",
  "version": "0.1.0",
  "description": "CYE — Control y Estudios: generación de planes de control de calidad valorados en obra civil",
  "main": "./out/main/index.js",
  "author": "Nigal",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "kb:import-alagal": "tsx src/main/pipeline/harness/kb/importAlagal.ts",
    "kb:import-cye": "tsx src/main/pipeline/harness/kb/importCye.ts",
    "kb:build": "tsx src/main/pipeline/harness/kb/buildKb.ts",
    "kb:plan": "tsx src/main/pipeline/harness/kb/planDemo.ts",
    "rag:demo": "tsx src/main/pipeline/harness/ragDemo.ts",
    "rag:eval": "tsx src/main/pipeline/harness/evaluate.ts",
    "rag:build-embeddings": "tsx src/main/pipeline/harness/buildEmbeddings.ts",
    "plan:demo": "tsx src/main/pipeline/harness/planDemo.ts",
    "extract:demo": "tsx src/main/pipeline/harness/extractDemo.ts",
    "ingest:demo": "tsx src/main/pipeline/harness/ingestDemo.ts",
    "template:build": "tsx src/main/pipeline/formatter/buildTemplate.ts",
    "template:presupuesto": "node scripts/buildPresupuestoTemplate.js",
    "deliver:demo": "tsx src/main/pipeline/harness/deliverDemo.ts",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "rag:historical": "tsx src/main/pipeline/harness/buildHistoricalProjects.ts",
    "rag:benchmark": "tsx src/main/pipeline/harness/benchmarkLLM.ts",
    "rag:compare": "tsx src/main/pipeline/harness/ragCompare.ts",
    "rag:cases": "tsx src/main/pipeline/harness/buildCasesFromBudgets.ts",
    "rag:price-book": "tsx src/main/pipeline/harness/buildPriceBook.ts",
    "rag:review-pricebook": "tsx src/main/pipeline/harness/priceBookReview.ts",
    "rag:review-pricer": "tsx src/main/pipeline/harness/labPricerReview.ts",
    "rag:thresholds": "tsx src/main/pipeline/harness/ragThresholds.ts"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^12.10.1",
    "docx": "^9.7.1",
    "docxtemplater": "^3.68.7",
    "exceljs": "^4.4.0",
    "hyperformula": "^3.3.0",
    "mammoth": "^1.12.0",
    "pizzip": "^3.2.0",
    "react-router-dom": "^7.18.0",
    "sharp": "^0.32.6",
    "unpdf": "^1.6.2",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
